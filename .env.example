# Health needs no credentials. Server information requires a reader token.
# Copy to .env and pass --env-file .env to Uvicorn to load these values.
SERVERWATCH_APP_NAME=ServerWatch
SERVERWATCH_ENVIRONMENT=development
SERVERWATCH_SERVER_ID=1
SERVERWATCH_SERVER_NAME=ServerWatch server
# Uncomment and replace locally; never commit a real token.
# SERVERWATCH_READER_TOKEN=REPLACE_LOCALLY
# File-backed alternative takes precedence when set:
# SERVERWATCH_READER_TOKEN_FILE=/run/secrets/reader_token
