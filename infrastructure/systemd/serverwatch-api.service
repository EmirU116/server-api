[Unit]
Description=ServerWatch Ubuntu monitoring API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=@RUN_USER@
WorkingDirectory=@PROJECT_DIR@
EnvironmentFile=@CONFIG_DIR@/api.env
ExecStart=@PROJECT_DIR@/.venv/bin/python -m uvicorn app.main:create_app --factory --app-dir @PROJECT_DIR@/backend --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
