[Unit]
Description=ServerWatch native EC2 API test service
After=network.target

[Service]
Type=simple
User=@RUN_USER@
WorkingDirectory=@PROJECT_DIR@
EnvironmentFile=@CONFIG_DIR@/serverwatch.env
ExecStart=@PROJECT_DIR@/.venv/bin/python -m uvicorn app.main:create_app --factory --app-dir @PROJECT_DIR@/backend --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
